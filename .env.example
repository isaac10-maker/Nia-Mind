# ============================================================================
# NIA-MIND — Variables d'environnement (Modèle sécurisé sans secret exposé)
# ============================================================================

# 1. Configuration publique Supabase (exposée côté client uniquement pour RLS)
# Toutes les tables privées sont protégées par Row Level Security (RLS) côté serveur.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_publique_anon_supabase

# 2. Configuration serveur uniquement (JAMAIS préfixée par VITE_)
# Utilisée exclusivement dans les fonctions serverless Vercel (/api/assistant)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete_serveur
AI_PROVIDER=openai
OPENAI_API_KEY=votre_cle_api_ia_cote_serveur_uniquement
AI_MODEL=gpt-4o-mini

# 3. Paramètres applicatifs optionnels
VITE_APP_ENV=production
VITE_DEFAULT_COUNTRY=BF
